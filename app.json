{
  "expo": {
    "name": "Calculadora de Mercado",
    "slug": "Calculara_de_mercado",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calcularademercado",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.calcularademercado.app",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.calcularademercado.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    // "plugins": [
    //   "expo-router",
    //   [
    //     "expo-splash-screen",
    //     {
    //       "backgroundColor": "#071016"
    //     }
    //   ]
    // ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d4d622c-9b4a-4f21-bf00-e622591160a5"
      }
    },
    "owner": "dean_paiva"
  }
}
